# Sandbox image for workers and verify runs. It contains tools, never secrets.
# Build:  docker build -f docker/Dockerfile.agent -t vpsa-agent:latest .      (add --build-arg AGENT_INSTALL="..." to use another agent)
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv git ca-certificates ripgrep \
    && rm -rf /var/lib/apt/lists/*
# Coding agent. Default: aider (edits via plain-text diffs, so it works with weaker free models). Pinned so a new release
# can't change behaviour under you; bump on purpose. Use another agent by overriding AGENT_INSTALL.
ARG AGENT_INSTALL="python3 -m venv /opt/aider && /opt/aider/bin/pip install --no-cache-dir aider-chat==0.86.2 && ln -s /opt/aider/bin/aider /usr/local/bin/aider"
RUN sh -c "$AGENT_INSTALL"
# Bake each project's dependencies here (verify runs have no network by default), e.g.:
#   RUN pip install --no-cache-dir pytest requests
RUN mkdir -p /home/agent /work && chmod 1777 /home/agent
WORKDIR /work
